{
  "$schema": "Khoj design tokens v1 — W3C design-tokens style (value / type / description)",
  "meta": {
    "name": "Khoj",
    "version": "1.0.0",
    "unit": "1 unit = 1 CSS px = 1 macOS point (= 1 Windows effective pixel at 100% scale)",
    "sources": [
      "Measured from Windows 11 File Explorer reference screenshots supplied by the client (dark theme, 100% scale, 1920px wide).",
      "Microsoft Learn — Geometry in Windows 11 (corner radii), Typography in Windows 11 (type ramp).",
      "WinUI theme resource names used as references (SolidBackgroundFillColorBase, TextFillColorPrimary, AccentFillColorDefault ...)."
    ],
    "note": "Values marked 'measured' were sampled pixel-by-pixel from the reference screenshots. Light-theme values are derived from WinUI light resources; verify against a real Windows 11 light-mode screenshot before freezing."
  },

  "font": {
    "family": {
      "ui": { "value": "\"Segoe UI Variable Text\", \"Segoe UI\", \"Selawik\", -apple-system, BlinkMacSystemFont, \"SF Pro Text\", system-ui, sans-serif", "type": "fontFamily", "description": "Bundle Selawik (SIL OFL 1.1) inside the app so Macs get the Segoe-like look. Segoe UI itself cannot be redistributed." },
      "display": { "value": "\"Segoe UI Variable Display\", \"Segoe UI\", \"Selawik\", -apple-system, system-ui, sans-serif", "type": "fontFamily" },
      "mono": { "value": "\"Cascadia Mono\", \"SF Mono\", Menlo, Consolas, monospace", "type": "fontFamily", "description": "Cascadia is OFL-licensed and can be bundled." }
    },
    "ramp": {
      "item":        { "value": { "size": 12, "lineHeight": 16, "weight": 400 }, "description": "Explorer item text (nav pane, file names, status bar) — Windows uses 9pt = 12px." },
      "caption":     { "value": { "size": 12, "lineHeight": 16, "weight": 400 } },
      "body":        { "value": { "size": 14, "lineHeight": 20, "weight": 400 }, "description": "Address bar, search box, dialogs." },
      "bodyStrong":  { "value": { "size": 14, "lineHeight": 20, "weight": 600 }, "description": "Group headers such as 'Devices and drives'." },
      "bodyLarge":   { "value": { "size": 18, "lineHeight": 24, "weight": 400 } },
      "subtitle":    { "value": { "size": 20, "lineHeight": 28, "weight": 600 }, "description": "Dialog titles, Details pane file name." },
      "title":       { "value": { "size": 28, "lineHeight": 36, "weight": 600 }, "description": "Onboarding / empty states." }
    },
    "scale": { "value": [1.0, 1.1, 1.25], "description": "User setting 'Text size'. Mac Retina at 1.0 reads slightly smaller than Windows at 100%; default 1.0, offer 1.1." }
  },

  "radius": {
    "control": { "value": 4, "description": "Buttons, inputs, list-item backplates, progress bars (Windows 11 ControlCornerRadius)." },
    "overlay": { "value": 8, "description": "Window, tabs (top corners), menus, flyouts, dialogs, tooltips are 4." },
    "none":    { "value": 0, "description": "Maximised / full-screen window corners, joined split-buttons." }
  },

  "space": { "value": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48], "description": "4-px based grid." },

  "size": {
    "window.min":            { "value": { "width": 640, "height": 400 } },
    "window.default":        { "value": { "width": 1280, "height": 800 } },
    "tabStrip.height":       { "value": 32, "description": "measured (0–31px)" },
    "tab.width":             { "value": { "min": 120, "default": 240, "max": 240 }, "description": "measured active tab 240px; shrinks as tabs are added." },
    "tab.inset":             { "value": 8, "description": "measured: first tab starts 8px from left edge." },
    "captionButton":         { "value": { "width": 46, "height": 32 }, "description": "Windows-style minimise / maximise / close, right-aligned." },
    "addressRow.height":     { "value": 48, "description": "measured (32–80px)" },
    "addressBox.height":     { "value": 32, "description": "measured (40–72px)" },
    "navButton":             { "value": { "width": 40, "height": 32, "pitch": 48 }, "description": "Back / Forward / Up / Refresh centres at 26, 74, 122, 170px." },
    "searchBox.width":       { "value": { "min": 200, "default": "26%", "max": 520 } },
    "commandBar.height":     { "value": 48, "description": "measured (81–127px) incl. 1px dividers top and bottom" },
    "commandButton":         { "value": { "iconOnly": 40, "withLabel": "auto", "height": 32 } },
    "navPane.width":         { "value": { "min": 160, "default": 300, "max": 600 }, "description": "measured divider at x=302" },
    "navItem.height":        { "value": 32, "description": "measured pitch 32px" },
    "navItem.indent":        { "value": 8, "description": "measured: child chevron +8px per level" },
    "row.details":           { "value": { "normal": 32, "compact": 24 } },
    "row.content":           { "value": 48, "description": "measured 'Content' view row" },
    "tile.drive":            { "value": { "width": 254, "height": 56, "icon": 48, "bar": { "width": 190, "height": 12 } }, "description": "measured This PC drive tile" },
    "icon":                  { "value": { "nav": 16, "command": 20, "details": 16, "content": 32, "tiles": 48, "medium": 48, "large": 96, "xl": 256 } },
    "detailsPane.width":     { "value": { "min": 240, "default": 320, "max": 560 } },
    "statusBar.height":      { "value": 24 }
  },

  "color": {
    "dark": {
      "tabStrip.bg":            { "value": "#202020", "description": "measured — Mica fallback (SolidBackgroundFillColorBase)" },
      "tab.active.bg":          { "value": "#2C2C2C", "description": "measured — merges into the address row" },
      "tab.hover.bg":           { "value": "#2A2A2A" },
      "addressRow.bg":          { "value": "#2C2C2C", "description": "measured" },
      "input.bg":               { "value": "#383838", "description": "measured — address + search boxes" },
      "input.bg.hover":         { "value": "#3D3D3D" },
      "input.bg.focus":         { "value": "#1F1F1F" },
      "input.focusUnderline":   { "value": "#60CDFF", "description": "AccentFillColorDefault (dark)" },
      "commandBar.bg":          { "value": "#191919", "description": "measured" },
      "content.bg":             { "value": "#191919", "description": "measured — nav pane + file view" },
      "statusBar.bg":           { "value": "#1C1C1C", "description": "measured" },
      "divider":                { "value": "#2B2B2B", "description": "measured — row dividers, pane splitter" },
      "divider.strong":         { "value": "#3A3A3A", "description": "measured — above/below command bar" },
      "navDivider":             { "value": "#383838", "description": "measured — between nav groups" },
      "text.primary":           { "value": "#FFFFFF", "description": "measured" },
      "text.secondary":         { "value": "#CFCFCF", "description": "≈ #C5FFFFFF over #191919; drive captions measured #DEDEDE" },
      "text.tertiary":          { "value": "#9D9D9D" },
      "text.disabled":          { "value": "#5B5A5A", "description": "measured — disabled command icons" },
      "text.placeholder":       { "value": "#D2D2D2", "description": "measured search placeholder" },
      "fill.hover":             { "value": "#2D2D2D" },
      "fill.pressed":           { "value": "#292929" },
      "fill.selected":          { "value": "#505050", "description": "measured — focused selection" },
      "fill.selected.hover":    { "value": "#5A5A5A" },
      "fill.selected.inactive": { "value": "#333333", "description": "measured — selection when the pane is not focused" },
      "focus.ring":             { "value": "#C3C3C3", "description": "measured — 1px keyboard focus rectangle" },
      "accent":                 { "value": "#60CDFF", "description": "AccentFillColorDefault (dark) — links, focus underline, toggles" },
      "accent.text":            { "value": "#99EBFF" },
      "drive.bar.fill":         { "value": "#0070CB", "description": "measured" },
      "drive.bar.track":        { "value": "#E6E6E6", "description": "measured — light track even in dark mode" },
      "drive.bar.border":       { "value": "#BCBCBC" },
      "drive.bar.low":          { "value": "#DA2626", "description": "used when free space < 10%" },
      "caption.hover":          { "value": "#2D2D2D" },
      "caption.close.hover":    { "value": "#C42B1C" },
      "overlay.bg":             { "value": "#2C2C2C", "description": "menus, flyouts (acrylic fallback)" },
      "overlay.border":         { "value": "#3D3D3D" },
      "overlay.shadow":         { "value": "0 8px 16px rgba(0,0,0,.36)" },
      "dialog.bg":              { "value": "#2B2B2B" },
      "dialog.footer":          { "value": "#202020" },
      "scrim":                  { "value": "rgba(0,0,0,.30)" },
      "success":                { "value": "#6CCB5F" },
      "caution":                { "value": "#FCE100" },
      "critical":               { "value": "#FF99A4" }
    },
    "light": {
      "tabStrip.bg":            { "value": "#EEF1F5", "description": "Mica-light (wallpaper tinted); solid fallback #F3F3F3" },
      "tab.active.bg":          { "value": "#F9F9F9" },
      "tab.hover.bg":           { "value": "#F3F5F8" },
      "addressRow.bg":          { "value": "#F9F9F9" },
      "input.bg":               { "value": "#FFFFFF" },
      "input.border":           { "value": "#E5E5E5" },
      "input.bg.hover":         { "value": "#FDFDFD" },
      "input.bg.focus":         { "value": "#FFFFFF" },
      "input.focusUnderline":   { "value": "#005FB8", "description": "AccentFillColorDefault (light)" },
      "commandBar.bg":          { "value": "#FFFFFF" },
      "content.bg":             { "value": "#FFFFFF" },
      "statusBar.bg":           { "value": "#FFFFFF" },
      "divider":                { "value": "#EBEBEB" },
      "divider.strong":         { "value": "#E0E0E0" },
      "navDivider":             { "value": "#E5E5E5" },
      "text.primary":           { "value": "#1B1B1B", "description": "#E4000000 over white" },
      "text.secondary":         { "value": "#5D5D5D", "description": "#9E000000 over white" },
      "text.tertiary":          { "value": "#8A8A8A" },
      "text.disabled":          { "value": "#A0A0A0" },
      "text.placeholder":       { "value": "#6E6E6E" },
      "fill.hover":             { "value": "#E5F3FF" },
      "fill.pressed":           { "value": "#D8ECFF" },
      "fill.selected":          { "value": "#CCE8FF" },
      "fill.selected.border":   { "value": "#99D1FF" },
      "fill.selected.hover":    { "value": "#C2E3FF" },
      "fill.selected.inactive": { "value": "#D9D9D9" },
      "focus.ring":             { "value": "#6E6E6E" },
      "accent":                 { "value": "#005FB8" },
      "accent.text":            { "value": "#003E92" },
      "drive.bar.fill":         { "value": "#26A0DA" },
      "drive.bar.track":        { "value": "#E6E6E6" },
      "drive.bar.border":       { "value": "#BCBCBC" },
      "drive.bar.low":          { "value": "#DA2626" },
      "caption.hover":          { "value": "#E9E9E9" },
      "caption.close.hover":    { "value": "#C42B1C" },
      "overlay.bg":             { "value": "#F9F9F9" },
      "overlay.border":         { "value": "#E0E0E0" },
      "overlay.shadow":         { "value": "0 8px 16px rgba(0,0,0,.14)" },
      "dialog.bg":              { "value": "#FFFFFF" },
      "dialog.footer":          { "value": "#F3F3F3" },
      "scrim":                  { "value": "rgba(0,0,0,.20)" },
      "success":                { "value": "#0F7B0F" },
      "caution":                { "value": "#9D5D00" },
      "critical":               { "value": "#C42B1C" }
    }
  },

  "motion": {
    "fast":   { "value": "83ms",  "description": "hover / press colour changes" },
    "normal": { "value": "167ms", "description": "menus, tooltips, pane toggles" },
    "slow":   { "value": "250ms", "description": "dialogs, page transitions" },
    "easing": { "value": "cubic-bezier(0.1, 0.9, 0.2, 1)", "description": "Fluent 'decelerate' curve for entering elements" }
  },

  "elevation": {
    "flyout":  { "value": "0 8px 16px rgba(0,0,0,.14), 0 0 2px rgba(0,0,0,.12)" },
    "dialog":  { "value": "0 32px 64px rgba(0,0,0,.28), 0 2px 21px rgba(0,0,0,.22)" },
    "tooltip": { "value": "0 4px 8px rgba(0,0,0,.14)" }
  }
}
